<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="타임트래커"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".NotesActivity"
            android:exported="true"
            android:label="메모"
            android:icon="@mipmap/ic_memo"
            android:taskAffinity="com.spoonwork.timetracker.notes">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".NoteEditActivity"
            android:exported="false"
            android:taskAffinity="com.spoonwork.timetracker.notes"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".QuickActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity="com.spoonwork.timetracker.quick"
            android:theme="@style/QuickTheme"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="com.spoonwork.timetracker.action"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".TrackerWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <service
            android:name=".RefreshJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".WidgetListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>
</manifest>
