<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="QuickTheme" parent="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar">
        <item name="android:windowMinWidthMajor">92%</item>
        <item name="android:windowMinWidthMinor">92%</item>
    </style>
    <style name="WidgetChip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:layout_marginEnd">2dp</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#374151</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
